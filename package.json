{
    "name": "finbuddy",
    "private": true,
    "version": "3.0.0",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "tsc --noEmit && vite build",
        "test": "vitest",
        "test:ui": "vitest --ui",
        "test:run": "vitest run",
        "test:coverage": "vitest run --coverage",
        "test:unit": "vitest run tests/unit",
        "test:integration": "vitest run tests/integration",
        "test:e2e": "vitest run tests/e2e",
        "test:watch": "vitest watch",
        "test:ci": "vitest run --reporter=verbose --coverage",
        "test:pre-deploy": "npm run lint && npm run test:run && npm run build",
        "lint": "eslint .",
        "optimize": "vite optimize",
        "preview": "vite preview",
        "version:bump": "node scripts/version-bump.js",
        "version:major": "npm run version:bump major",
        "version:minor": "npm run version:bump minor",
        "version:patch": "npm run version:bump patch",
        "changelog": "code CHANGELOG.md",
        "deploy:build": "npm run build",
        "deploy:firebase": "firebase deploy --only hosting",
        "deploy": "npm run deploy:build && npm run deploy:firebase",
        "deploy:preview": "npm run deploy:build && firebase hosting:channel:deploy preview",
        "test:browser": "playwright test",
        "typecheck": "tsc --noEmit"
    },
    "dependencies": {
        "@fontsource-variable/google-sans": "5.3.2",
        "@fontsource-variable/lora": "5.3.0",
        "@fontsource-variable/open-sans": "5.3.0",
        "@fontsource-variable/roboto": "5.3.0",
        "@fontsource-variable/source-code-pro": "5.3.1",
        "@fontsource-variable/source-sans-3": "5.3.1",
        "@fontsource-variable/source-serif-4": "5.3.1",
        "@fontsource/lato": "5.3.0",
        "@fontsource/ubuntu": "5.3.0",
        "@radix-ui/react-alert-dialog": "^1.1.6",
        "@radix-ui/react-dialog": "^1.1.6",
        "@radix-ui/react-dropdown-menu": "^2.1.6",
        "@radix-ui/react-label": "^2.1.2",
        "@radix-ui/react-popover": "^1.1.6",
        "@radix-ui/react-progress": "^1.1.2",
        "@radix-ui/react-select": "^2.4.1",
        "@radix-ui/react-separator": "^1.1.2",
        "@radix-ui/react-slot": "^1.1.2",
        "@radix-ui/react-switch": "^1.1.3",
        "@radix-ui/react-tabs": "^1.1.3",
        "@tailwindcss/vite": "^4.1.11",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "firebase": "12.15.0",
        "react": "^19.0.0",
        "react-dom": "^19.0.0",
        "react-error-boundary": "^6.0.0",
        "sonner": "^2.0.1",
        "tailwind-merge": "^3.0.2",
        "tw-animate-css": "^1.2.4",
        "zod": "^4.1.11"
    },
    "devDependencies": {
        "@eslint/js": "^9.21.0",
        "@playwright/test": "1.65.0",
        "@testing-library/jest-dom": "^6.8.0",
        "@testing-library/react": "^16.3.0",
        "@testing-library/user-event": "^14.6.1",
        "@types/react": "^19.0.10",
        "@types/react-dom": "^19.0.4",
        "@vitejs/plugin-react": "^5.0.1",
        "@vitejs/plugin-react-swc": "^4.1.0",
        "@vitest/coverage-v8": "4.1.12",
        "@vitest/ui": "4.1.12",
        "eslint": "^9.28.0",
        "eslint-plugin-react-hooks": "^5.2.0",
        "eslint-plugin-react-refresh": "^0.4.19",
        "globals": "^16.0.0",
        "jsdom": "^26.1.0",
        "tailwindcss": "^4.1.11",
        "typescript": "~5.9.2",
        "typescript-eslint": "^8.38.0",
        "vite": "^7.1.7",
        "vitest": "4.1.12"
    },
    "overrides": {
        "@firebase/firestore": {
            "@grpc/grpc-js": "1.13.7"
        }
    }
}
