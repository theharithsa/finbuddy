{
  "functions": [
    {
      "source": "api",
      "codebase": "finbuddy-api-preprod",
      "ignore": [
        "node_modules",
        ".git",
        "tests",
        "dist/tests",
        "*.local",
        "firebase-debug*.log"
      ],
      "predeploy": [
        "npm --prefix \"$RESOURCE_DIR\" run build"
      ]
    }
  ],
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  }
}
